# Copy to .env.local and replace the placeholders. Never commit .env.local.

# MongoDB. The database name is also set by MONGODB_DB.
MONGODB_URI=mongodb://127.0.0.1:27017/saas
MONGODB_DB=saas

# Required by Auth.js. Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-string-at-least-32-chars

# Public origin. Set this in Docker or behind a reverse proxy.
AUTH_URL=http://localhost:3000

# Optional. Leave both blank to hide the GitHub button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Set to true to allow `npm run seed` when NODE_ENV=production.
SEED_DEMO_DATA=
